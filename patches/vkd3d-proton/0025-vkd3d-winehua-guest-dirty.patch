From 731d97513dda66ddd65ca5a9875dd7ec175ff517 Mon Sep 17 00:00:00 2001
From: yifengling0 <yifengling0@users.noreply.github.com>
Date: Sun, 16 Aug 2026 11:31:45 +0800
Subject: [PATCH] mods

---
 libs/vkd3d/vkd3d_private.h | 22 ++++++++++++++++++++++
 1 file changed, 22 insertions(+)

diff --git a/libs/vkd3d/vkd3d_private.h b/libs/vkd3d/vkd3d_private.h
index 54b4495..9286f03 100644
--- a/libs/vkd3d/vkd3d_private.h
+++ b/libs/vkd3d/vkd3d_private.h
@@ -3003,6 +3003,28 @@ struct d3d12_device
     struct vkd3d_vulkan_info vk_info;
     struct vkd3d_physical_device_info device_info;
 
+    /* WineHua GPU-upload: current recording command list, used by Unmap to
+     * send mapped data via vkCmdUpdateBuffer (GPU upload, no host shadow). */
+    struct d3d12_command_list *current_recording_list;
+    /* WineHua GPU-upload queue: Unmap may happen outside a recording list;
+     * ranges are queued here and emitted on the next command-list Begin. */
+    struct d3d12_gpu_upload *pending_gpu_uploads;
+    size_t pending_gpu_upload_count;
+    size_t pending_gpu_upload_cap;
+
+    /* WineHua Lazy Flush: Unmap 记录 dirty range，Submit 前统一 flush。 */
+    struct d3d12_pending_flush *pending_flushes;
+    size_t pending_flush_count;
+    size_t pending_flush_cap;
+
+    /* WineHua guest-side dirty tracking: 所有 UPLOAD mapped resources 链表。 */
+    struct d3d12_resource *upload_resources;
+    unsigned long long flush_submit_count;
+    VkDeviceSize flush_declared_bytes;
+    unsigned long long flush_declared_count;
+    VkDeviceSize flush_unique_bytes;
+    unsigned long long flush_unique_count;
+
     struct vkd3d_queue_family_info *queue_families[VKD3D_QUEUE_FAMILY_COUNT];
     uint32_t queue_family_indices[VKD3D_QUEUE_FAMILY_COUNT];
     uint32_t queue_family_count;
-- 
