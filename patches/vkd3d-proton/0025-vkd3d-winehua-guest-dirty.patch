+void d3d12_device_remove_pending_flush_resource(struct d3d12_device *device,
+        struct d3d12_resource *resource)
+{
+    size_t i = 0;
+
+    while (i < device->pending_flush_count)
+    {
+        if (device->pending_flushes[i].resource == resource)
+        {
+            device->pending_flushes[i] = device->pending_flushes[device->pending_flush_count - 1];
+            device->pending_flush_count--;
+        }
+        else
+        {
+            i++;
+        }
+    }
+}
