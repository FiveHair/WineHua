+/* WineHua guest-side dirty tracking: 遍历所有 UPLOAD resources，对 guest
+ * shadow 与本地快照做 memcmp（本地访问快），找出真实脏段，只对脏段调
+ * vkFlushMappedMemoryRanges（guest mesa 会精确 record，virgl 只同步脏段）。 */
+void d3d12_device_flush_guest_dirty(struct d3d12_device *device)
+{
+    const struct vkd3d_vk_device_procs *vk_procs = &device->vk_procs;
+    struct d3d12_resource *res = device->upload_resources;
+    const VkDeviceSize page = 65536;
+    uint32_t diff_resources = 0;
+    uint64_t diff_total = 0;
+    uint64_t scan_total = 0;
+    uint64_t flush_entries = 0;
+    VkMappedMemoryRange ranges[256];
+
+    while (res)
+    {
+        struct d3d12_resource *next = res->upload_list_next;
+
+        if (res->mem.cpu_address && res->res.vk_buffer &&
+            res->desc.Dimension == D3D12_RESOURCE_DIMENSION_BUFFER &&
+            res->desc.Width && res->desc.Width <= (VkDeviceSize)1024u * 1024u * 64u)
+        {
+            const VkDeviceSize size = res->desc.Width;
+            const uint8_t *shadow = (const uint8_t *)res->mem.cpu_address;
+            uint8_t *snap;
+            uint64_t nrange = 0;
+            VkDeviceSize off = 0;
+
+            if (!res->guest_dirty_snapshot)
+            {
+                res->guest_dirty_snapshot = vkd3d_malloc((size_t)size);
+                if (!res->guest_dirty_snapshot)
+                {
+                    res = next;
+                    continue;
+                }
+                res->guest_dirty_snapshot_size = size;
+                memcpy(res->guest_dirty_snapshot, shadow, (size_t)size);
+                res = next;
+                continue;
+            }
+            snap = res->guest_dirty_snapshot;
+
+            scan_total += size;
+            while (off < size)
+            {
+                const VkDeviceSize sz = min(size - off, page);
+                if (memcmp(shadow + off, snap + off, (size_t)sz) != 0)
+                {
+                    VkDeviceSize seg_begin = off;
+                    VkDeviceSize seg_end = off;
+                    while (seg_end < size)
+                    {
+                        const VkDeviceSize ssz = min(size - seg_end, page);
+                        if (memcmp(shadow + seg_end, snap + seg_end, (size_t)ssz) == 0)
+                            break;
+                        seg_end += ssz;
+                    }
+                    if (nrange < 256)
+                    {
+                        ranges[nrange].sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE;
+                        ranges[nrange].pNext = NULL;
+                        ranges[nrange].memory = res->mem.device_allocation.vk_memory;
+                        ranges[nrange].offset = seg_begin;
+                        ranges[nrange].size = seg_end - seg_begin;
+                        nrange++;
+                    }
+                    diff_total += seg_end - seg_begin;
+                    memcpy(snap + seg_begin, shadow + seg_begin,
+                           (size_t)(seg_end - seg_begin));
+                    off = seg_end;
+                }
+                else
+                {
+                    off += sz;
+                }
+            }
+            if (nrange)
+            {
+                VK_CALL(vkFlushMappedMemoryRanges(device->vk_device, nrange, ranges));
+                flush_entries += nrange;
+                diff_resources++;
+            }
+        }
+        res = next;
+    }
+
+    winehua_gpu_log("GUEST-DIRTY res=%u entries=%llu diff=%llu scan=%llu",
+            diff_resources, (unsigned long long)flush_entries,
+            (unsigned long long)diff_total, (unsigned long long)scan_total);
+}
