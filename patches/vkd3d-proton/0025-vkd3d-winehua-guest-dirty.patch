+void d3d12_device_add_pending_flush(struct d3d12_device *device,
+        struct d3d12_resource *resource, VkDeviceSize offset, VkDeviceSize size)
+{
+    size_t i;
+
+    /* 合并同一资源的重叠/相邻 range。 */
+    for (i = 0; i < device->pending_flush_count; ++i)
+    {
+        struct d3d12_pending_flush *pf = &device->pending_flushes[i];
+        VkDeviceSize s0, e0, s1, e1, ne;
+
+        if (pf->resource != resource)
+            continue;
+        s0 = pf->offset;
+        e0 = s0 + pf->size;
+        s1 = offset;
+        e1 = s1 + size;
+        if (s1 <= e0 && e1 >= s0)
+        {
+            pf->offset = s0 < s1 ? s0 : s1;
+            ne = e0 > e1 ? e0 : e1;
+            pf->size = ne - pf->offset;
+            return;
+        }
+    }
+
+    if (device->pending_flush_count >= device->pending_flush_cap)
+    {
+        size_t ncap = device->pending_flush_cap ? device->pending_flush_cap * 2 : 64;
+        struct d3d12_pending_flush *n = vkd3d_realloc(device->pending_flushes,
+                ncap * sizeof(*n));
+
+        if (!n)
+            return;
+        device->pending_flushes = n;
+        device->pending_flush_cap = ncap;
+    }
+    {
+        struct d3d12_pending_flush *pf = &device->pending_flushes[device->pending_flush_count++];
+        pf->resource = resource;
+        pf->offset = offset;
+        pf->size = size;
+    }
+}
