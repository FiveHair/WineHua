+void d3d12_device_upload_list_add(struct d3d12_device *device,
+        struct d3d12_resource *resource)
+{
+    resource->upload_list_next = device->upload_resources;
+    resource->upload_list_prev = NULL;
+    if (device->upload_resources)
+        device->upload_resources->upload_list_prev = resource;
+    device->upload_resources = resource;
+}
+
+void d3d12_device_upload_list_remove(struct d3d12_device *device,
+        struct d3d12_resource *resource)
+{
+    if (resource->upload_list_prev)
+        resource->upload_list_prev->upload_list_next = resource->upload_list_next;
+    else if (device->upload_resources == resource)
+        device->upload_resources = resource->upload_list_next;
+    if (resource->upload_list_next)
+        resource->upload_list_next->upload_list_prev = resource->upload_list_prev;
+    resource->upload_list_next = NULL;
+    resource->upload_list_prev = NULL;
