+void d3d12_device_flush_pending(struct d3d12_device *device)
+{
+    const struct vkd3d_vk_device_procs *vk_procs = &device->vk_procs;
+    VkMappedMemoryRange *ranges;
+    size_t i;
+
+    winehua_gpu_log("FLUSH-ENTRY submit=%llu pending=%zu declared=%llu unique=%llu",
+            (unsigned long long)device->flush_submit_count, device->pending_flush_count,
+            (unsigned long long)device->flush_declared_bytes,
+            (unsigned long long)device->flush_unique_bytes);
+    if (!device->pending_flush_count)
+    {
+        device->flush_submit_count++;
+        return;
+    }
+
+    ranges = vkd3d_calloc(device->pending_flush_count, sizeof(*ranges));
+    if (!ranges)
+    {
+        device->flush_submit_count++;
+        return;
+    }
+
+    for (i = 0; i < device->pending_flush_count; ++i)
+    {
+        struct d3d12_pending_flush *pf = &device->pending_flushes[i];
+
+        ranges[i].sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE;
+        ranges[i].pNext = NULL;
+        ranges[i].memory = pf->resource->mem.device_allocation.vk_memory;
+        ranges[i].offset = pf->offset;
+        ranges[i].size = pf->size;
+        device->flush_unique_bytes += pf->size;
+    }
+    device->flush_unique_count += device->pending_flush_count;
+
+    VK_CALL(vkFlushMappedMemoryRanges(device->vk_device, device->pending_flush_count, ranges));
+    vkd3d_free(ranges);
+    device->pending_flush_count = 0;
+
+    device->flush_submit_count++;
+    winehua_gpu_log("LAZY-FLUSH declared=%llu unique=%llu dcount=%llu ucount=%llu ratio=%.1f",
+            (unsigned long long)device->flush_declared_bytes,
+            (unsigned long long)device->flush_unique_bytes,
+            (unsigned long long)device->flush_declared_count,
+            (unsigned long long)device->flush_unique_count,
+            device->flush_unique_bytes ?
+                (double)device->flush_declared_bytes / (double)device->flush_unique_bytes : 0.0);
+    device->flush_declared_bytes = 0;
+    device->flush_declared_count = 0;
+    device->flush_unique_bytes = 0;
+    device->flush_unique_count = 0;
+}
