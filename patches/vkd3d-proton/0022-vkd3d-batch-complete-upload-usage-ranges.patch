@@ -2235,6 +2239,10 @@ struct d3d12_command_queue_submission_execute
     LONG **outstanding_submissions_counters;
     UINT cmd_count;
     UINT winehua_exact_upload_range_count;
+    UINT winehua_exact_upload_source_range_count;
