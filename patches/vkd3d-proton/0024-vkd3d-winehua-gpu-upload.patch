From 9f92c13e00000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: WineHua <winehua@localhost>
Date: Sat Aug 15 00:00:00 2026
Subject: [PATCH] vkd3d-winehua-gpu-upload

diff --git a/libs/vkd3d/command.c b/libs/vkd3d/command.c
index 8f75883b..b7adea13 100644
--- a/libs/vkd3d/command.c
+++ b/libs/vkd3d/command.c
@@ -1129,6 +1129,7 @@ static HRESULT d3d12_command_list_begin_command_buffer(struct d3d12_command_list
 
     list->is_recording = true;
     list->is_valid = true;
+    device->current_recording_list = list;
 
     return S_OK;
 }
@@ -4166,6 +4167,9 @@ static HRESULT STDMETHODCALLTYPE d3d12_command_list_Close(d3d12_command_list_ifa
 
     d3d12_command_list_end_current_render_pass(list, false);
 
+    if (list->device->current_recording_list == list)
+        list->device->current_recording_list = NULL;
+
     if (list->predicate_enabled)
         VK_CALL(vkCmdEndConditionalRenderingEXT(list->vk_command_buffer));
 
diff --git a/libs/vkd3d/device.c b/libs/vkd3d/device.c
index 48ad556..6071280 100644
--- a/libs/vkd3d/device.c
+++ b/libs/vkd3d/device.c
@@ -1093,7 +1093,15 @@ static void vkd3d_physical_device_info_init(struct vkd3d_physical_device_info *i
     memset(info, 0, sizeof(*info));
 
     info->features2.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2;
+    info->driver_properties.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_DRIVER_PROPERTIES;
+    vk_prepend_struct(&info->properties2, &info->driver_properties);
     info->properties2.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2;
+#ifndef VK_DRIVER_ID_MESA_VENUS
+#define VK_DRIVER_ID_MESA_VENUS 22
+#endif
+    device->is_winehua_venus =
+        info->driver_properties.driverID == VK_DRIVER_ID_MESA_VENUS;
+    device->current_recording_list = NULL;
 
     info->subgroup_properties.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SUBGROUP_PROPERTIES;
     vk_prepend_struct(&info->properties2, &info->subgroup_properties);
diff --git a/libs/vkd3d/resource.c b/libs/vkd3d/resource.c
index 72fbb39c..edf63498 100644
--- a/libs/vkd3d/resource.c
+++ b/libs/vkd3d/resource.c
@@ -1567,6 +1567,30 @@ static void d3d12_resource_flush_range(struct d3d12_resource *resource,
     if (!d3d12_resource_get_mapped_memory_range(resource, subresource, written_range, &mapped_range))
         return;
 
+    /* WineHua GPU-upload: send the mapped data through vkCmdUpdateBuffer
+     * (data travels in the command stream) so virgl writes it directly to
+     * the GPU buffer - no host shadow copy / memcmp. Falls back to the
+     * mapped-memory flush (shadow path) when not recording. */
+    struct d3d12_command_list *recording = resource->device->current_recording_list;
+    if (resource->device->is_winehua_venus && recording && recording->is_recording &&
+        recording->vk_command_buffer && resource->res.vk_buffer && resource->mem.cpu_address)
+    {
+        const uint8_t *data = (const uint8_t *)resource->mem.cpu_address
+            + (mapped_range.offset - resource->mem.offset);
+        VkDeviceSize remaining = mapped_range.size;
+        VkDeviceSize off = 0;
+        const VkDeviceSize chunk = 65536;
+        while (remaining)
+        {
+            const VkDeviceSize sz = remaining < chunk ? remaining : chunk;
+            VK_CALL(vkCmdUpdateBuffer(recording->vk_command_buffer,
+                    resource->res.vk_buffer, off, sz, data + off));
+            off += sz;
+            remaining -= sz;
+        }
+        return;
+    }
+
     VK_CALL(vkFlushMappedMemoryRanges(resource->device->vk_device, 1, &mapped_range));
 }
 
diff --git a/libs/vkd3d/vkd3d_private.h b/libs/vkd3d/vkd3d_private.h
index 687bafc..8807dea 100644
--- a/libs/vkd3d/vkd3d_private.h
+++ b/libs/vkd3d/vkd3d_private.h
@@ -2818,6 +2818,7 @@ struct vkd3d_physical_device_info
     VkPhysicalDeviceFragmentShadingRatePropertiesKHR fragment_shading_rate_properties;
     VkPhysicalDeviceConservativeRasterizationPropertiesEXT conservative_rasterization_properties;
     VkPhysicalDeviceShaderIntegerDotProductPropertiesKHR shader_integer_dot_product_properties;
+    VkPhysicalDeviceDriverProperties driver_properties;
 
     VkPhysicalDeviceProperties2KHR properties2;
 
@@ -2986,6 +2987,7 @@ struct d3d12_device
 #endif
     VkPipelineCache global_pipeline_cache;
     uint64_t shader_interface_key;
+    bool is_winehua_venus;
 };
 
 HRESULT d3d12_device_create(struct vkd3d_instance *instance,
