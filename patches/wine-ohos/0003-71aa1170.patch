From 71aa11709bfc5ec656740b7359cf3f15a67ca2dc Mon Sep 17 00:00:00 2001
From: hackeris <hackeris@qq.com>
Date: Sat, 13 Jun 2026 22:53:45 +0800
Subject: [PATCH 003/104] feat(__OHOS__): dosdevices fallback for kernel32
 loading when symlink unavailable
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- nt_to_unix_file_name_no_root(): resolve drive letters to direct paths
  (c:→$WINEPREFIX/drive_c, z:→/)
- get_dos_device(): fallback for plain DOS device names
- setup_config_dir(): fd_cwd fallback when dosdevices/c: inaccessible
---
 dlls/ntdll/unix/file.c   | 33 +++++++++++++++++++++++++++++++++
 dlls/ntdll/unix/server.c |  3 +++
 2 files changed, 36 insertions(+)

diff --git a/dlls/ntdll/unix/file.c b/dlls/ntdll/unix/file.c
index b641e4ca3361..ff2e3ca486ab 100644
--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -3356,6 +3356,16 @@ static NTSTATUS get_dos_device( char **unix_name, int start_pos )
             dev[2] = 0;  /* remove last ':' to get the drive mount point symlink */
             new_name = get_default_drive_device( *unix_name );
         }
+#ifdef __OHOS__
+        /* OHOS: symlink not available, fall back to default drive mapping */
+        if (!new_name && dev[1] == ':')
+        {
+            if (dev[0] == 'z')
+                new_name = strdup( "/" );
+            else if (dev[0] >= 'c' && dev[0] <= 'y')
+                asprintf( &new_name, "%s/drive_%c", config_dir, dev[0] );
+        }
+#endif
         free( *unix_name );
         *unix_name = new_name;
         if (!new_name) return STATUS_BAD_DEVICE_TYPE;
@@ -3790,6 +3800,29 @@ static NTSTATUS nt_to_unix_file_name_no_root( OBJECT_ATTRIBUTES *attr, UNICODE_S
     }
     pos += ret;
 
+#ifdef __OHOS__
+    /* OHOS: symlink() not available in NAPI sandbox. For drive letter
+     * prefixes, fall back to hardcoded default directory paths.
+     * c: → $WINEPREFIX/drive_c, ..., z: → / */
+    if (prefix_len == 2 && prefix[1] == ':')
+    {
+        unix_name[pos] = 0;  /* null-terminate the prefix for lstat */
+        if (lstat( unix_name, &st ) == -1)
+        {
+            if (prefix[0] == 'z')
+            {
+                strcpy( unix_name, "/" );
+                pos = 1;
+            }
+            else if (prefix[0] >= 'c' && prefix[0] <= 'y')
+            {
+                pos = snprintf( unix_name, unix_len, "%s/drive_%c",
+                                config_dir, prefix[0] );
+            }
+        }
+    }
+#endif
+
     /* check if prefix exists (except for DOS drives to avoid extra stat calls) */
 
     if (wcschr( prefix, '/' ))
diff --git a/dlls/ntdll/unix/server.c b/dlls/ntdll/unix/server.c
index 34d1d5c937e1..8d976ceab467 100644
--- a/dlls/ntdll/unix/server.c
+++ b/dlls/ntdll/unix/server.c
@@ -1358,6 +1358,9 @@ static int setup_config_dir(void)
     else if (errno != EEXIST) fatal_perror( "cannot create %s/dosdevices", config_dir );
 
     if (fd_cwd == -1) fd_cwd = open( "dosdevices/c:", O_RDONLY );
+#ifdef __OHOS__
+    if (fd_cwd == -1) fd_cwd = open( "drive_c", O_RDONLY );
+#endif
     fcntl( fd_cwd, F_SETFD, FD_CLOEXEC );
     return fd_cwd;
 }

