--- /dev/null
+++ b/dlls/win32u/opengl_diag.c
@@ -0,0 +1,113 @@
+/*
+ * WineHua OpenGL diagnostic helpers
+ *
+ * Copyright 2025-2026 WineHua contributors
+ *
