Subject: [PATCH 018/104] =?UTF-8?q?=E4=BF=AE=E5=A4=8D:=20PAD=5FMODE=20?=
 =?UTF-8?q?=E5=AE=88=E5=8D=AB=20WINESERVERSOCKET=20=E6=AD=BB=E8=BF=9E?=
 =?UTF-8?q?=E6=8E=A5=E6=A3=80=E6=B5=8B=20+=20virtual.c=20Box64=20mmap=20?=
 =?UTF-8?q?=E5=9B=9E=E9=80=80?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- server.c: WINESERVERSOCKET 死连接检测加 #ifdef PAD_MODE (PC 不需要)
- virtual.c: Box64 anon_mmap 回退加 #ifdef __OHOS__ (非 OHOS 不需要)
- virtual.c: MAP_FIXED_NOREPLACE undef 加 #ifdef __OHOS__
---
 dlls/ntdll/unix/server.c  | 2 ++
 dlls/ntdll/unix/virtual.c | 4 ++++
 2 files changed, 6 insertions(+)

diff --git a/dlls/ntdll/unix/server.c b/dlls/ntdll/unix/server.c
index 03c1f1e64ff5..b821c3f10ca3 100644
--- a/dlls/ntdll/unix/server.c
+++ b/dlls/ntdll/unix/server.c
@@ -1629,6 +1629,7 @@ size_t server_init_process(void)
         MESSAGE( "[OHOS-LOADER] server_init WINESERVERSOCKET=%s, using fd directly\n", env_socket );
         fd_socket = atoi( env_socket );
 
+#ifdef PAD_MODE
         /* PAD_MODE: wineserver 可能在进程间传递 fd 期间退出。
          * recv(MSG_PEEK|MSG_DONTWAIT) 检测: 对方关闭返回 0，存活且无数据
          * 返回 -1/EAGAIN，有数据返回 >0（MSG_PEEK 不消耗）。 */
@@ -1644,6 +1645,7 @@ size_t server_init_process(void)
                 goto server_connect_fallback;
             }
         }
+#endif
 
         if (fcntl( fd_socket, F_SETFD, FD_CLOEXEC ) == -1)
             fatal_perror( "Bad server socket %d", fd_socket );
diff --git a/dlls/ntdll/unix/virtual.c b/dlls/ntdll/unix/virtual.c
index 795c4e33cd1e..1c6bcf62b7a8 100644
--- a/dlls/ntdll/unix/virtual.c
+++ b/dlls/ntdll/unix/virtual.c
@@ -592,8 +592,10 @@ static void *anon_mmap_tryfixed( void *start, size_t size, int prot, int flags )
 {
     void *ptr;
 
+#ifdef __OHOS__
 /* OHOS: Box64 wrapped mmap does not support MAP_FIXED_NOREPLACE */
 #undef MAP_FIXED_NOREPLACE
+#endif
 #ifdef MAP_FIXED_NOREPLACE
     ptr = mmap( start, size, prot, MAP_FIXED_NOREPLACE | MAP_PRIVATE | MAP_ANON | flags, -1, 0 );
 #elif defined(MAP_TRYFIXED)
@@ -4197,10 +4199,12 @@ struct thread_data *virtual_alloc_thread_data(void)
     }
     else
     {
+#ifdef __OHOS__
         /* OHOS: fallback to anon_mmap for Box64 compatibility */
         data = anon_mmap_alloc( size, PROT_READ | PROT_WRITE );
         if (data != MAP_FAILED)
             status = 0;
+#endif
     }
     if (!status)
     {

