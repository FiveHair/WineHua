 configure.ac                           |   1 -
 dlls/mmdevapi/main.c                   |   8 +-
 dlls/wineohos.drv/audio_ipc_protocol.h | 634 ++++++++++----------
 dlls/wineohos.drv/ohos.c               | 773 ++++++++++++++++++++++++-
 loader/wine.inf.in                     |   1 +
 5 files changed, 1091 insertions(+), 326 deletions(-)

