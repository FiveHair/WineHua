-
-    while (min <= max)
-    {
-        pos = (min + max) / 2;
-        if (!(res = strcmp( array.str[pos * 2], name ))) return array.str[pos * 2 + 1];
-        if (res < 0) min = pos + 1;
-        else max = pos - 1;
