+static char *replace_substr( const char *str, const char *start, size_t len, const char *replace )
+{
+    size_t pos = start - str;
+    char *ret = xmalloc( pos + strlen(replace) + strlen(start + len) + 1 );
+    memcpy( ret, str, pos );
+    strcpy( ret + pos, replace );
