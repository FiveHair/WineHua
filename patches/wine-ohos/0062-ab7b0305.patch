-/*******************************************************************
- *         escape_cstring
- */
-static const char *escape_cstring( const char *str )
-{
-    char *ret;
-    unsigned int i = 0, j = 0;
-
-    if (!strpbrk( str, "\\\"" )) return str;
-    ret = xmalloc( 2 * strlen(str) + 1 );
-    while (str[i])
-    {
-        if (str[i] == '\\' || str[i] == '"') ret[j++] = '\\';
-        ret[j++] = str[i++];
-    }
-    ret[j] = 0;
-    return ret;
-}
