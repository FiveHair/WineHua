From: hackeris <hackeris@qq.com>
Date: Fri, 26 Jun 2026 21:12:39 +0800
Subject: [PATCH 021/104] =?UTF-8?q?server:=20=E6=96=B0=E5=A2=9E=20--no-aut?=
 =?UTF-8?q?o-close=20=E9=80=89=E9=A1=B9=EF=BC=8C=E7=A6=81=E6=AD=A2?=
 =?UTF-8?q?=E6=A1=8C=E9=9D=A2=E8=87=AA=E5=8A=A8=E5=85=B3=E9=97=AD?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Wine virtual desktop 在最后一个非系统进程退出时，
remove_desktop_user 会调度 close_desktop_timeout，
1秒后广播 WM_CLOSE 导致 explorer 退出。

新增 --no-auto-close 启动参数，跳过该超时逻辑，
desktop 保持永久存活。

涉及:
- main.c: 注册 --no-auto-close long option, no_auto_close 变量
- object.h: 声明 extern int no_auto_close
- winstation.c: close_desktop_timeout 检查标志并跳过
---
 server/main.c       | 6 ++++++
 server/object.h     | 1 +
 server/winstation.c | 7 +++++--
 3 files changed, 12 insertions(+), 2 deletions(-)

diff --git a/server/main.c b/server/main.c
index bc7f32d5fa15..a0dc46512fd2 100644
--- a/server/main.c
+++ b/server/main.c
@@ -44,6 +44,7 @@
 /* command-line options */
 int debug_level = 0;
 int foreground = 0;
+int no_auto_close = 0;
 timeout_t master_socket_timeout = 3 * -TICKS_PER_SEC;  /* master socket timeout, default is 3 seconds */
 const char *server_argv0;
 
@@ -58,6 +59,7 @@ static void usage( FILE *fh )
     fprintf(fh, "   -h,    --help            display this help message\n");
     fprintf(fh, "   -k[n], --kill[=n]        kill the current wineserver, optionally with signal n\n");
     fprintf(fh, "   -p[n], --persistent[=n]  make server persistent, optionally for n seconds\n");
+    fprintf(fh, "   --no-auto-close           don't close desktop when last non-system process exits\n");
     fprintf(fh, "   -v,    --version         display version information and exit\n");
     fprintf(fh, "   -w,    --wait            wait until the current wineserver terminates\n");
     fprintf(fh, "\n");
@@ -78,6 +80,9 @@ static void option_callback( int optc, char *optarg )
     case 'f':
         foreground = 1;
         break;
+    case 128:  /* --no-auto-close */
+        no_auto_close = 1;
+        break;
     case 'h':
         usage(stdout);
         exit(0);
@@ -118,6 +123,7 @@ static struct long_option
     {"help",        0, 'h'},
     {"kill",        2, 'k'},
     {"persistent",  2, 'p'},
+    {"no-auto-close", 0, 128},  /* 128 = non-ASCII, long-only */
     {"version",     0, 'v'},
     {"wait",        0, 'w'},
     { NULL }
diff --git a/server/object.h b/server/object.h
index 171ca2f8904d..926cd9178276 100644
--- a/server/object.h
+++ b/server/object.h
@@ -341,6 +341,7 @@ extern struct object *create_symlink( struct object *root, const struct unicode_
   /* command-line options */
 extern int debug_level;
 extern int foreground;
+extern int no_auto_close;
 extern timeout_t master_socket_timeout;
 extern const char *server_argv0;
 
diff --git a/server/winstation.c b/server/winstation.c
index 4329f9f4384a..9a254e56bf5e 100644
--- a/server/winstation.c
+++ b/server/winstation.c
@@ -418,8 +418,11 @@ static void close_desktop_timeout( void *private )
     struct desktop *desktop = private;
 
     desktop->close_timeout = NULL;
-    unlink_named_object( &desktop->obj );  /* make sure no other process can open it */
-    post_desktop_message( desktop, WM_CLOSE, 0, 0 );  /* and signal the owner to quit */
+    if (!no_auto_close)
+    {
+        unlink_named_object( &desktop->obj );  /* make sure no other process can open it */
+        post_desktop_message( desktop, WM_CLOSE, 0, 0 );  /* and signal the owner to quit */
+    }
 }
 
 /* add a user of the desktop and cancel the close timeout */

