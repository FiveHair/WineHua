From c96fc9d99317b1063bc2a30c4ce8f08aa8bf9a8f Mon Sep 17 00:00:00 2001
From: yifengling0 <yifengling0@users.noreply.github.com>
Date: Fri, 17 Jul 2026 10:57:38 +0800
Subject: [PATCH 049/104] fix(opengl32): preserve parsed legacy extension
 indices

parse_extensions() returns opengl_extension values, but the OpenGL 2.x path enabled entries by loop position. This advertised an unrelated prefix of the extension table and could hide GL_ARB_vertex_buffer_object, causing applications to skip VBO and IBO setup. Enable each parsed enum value instead.
---
 dlls/opengl32/unix_wgl.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/dlls/opengl32/unix_wgl.c b/dlls/opengl32/unix_wgl.c
index fbf5654aeaac..9e0e4c9c6b0b 100644
--- a/dlls/opengl32/unix_wgl.c
+++ b/dlls/opengl32/unix_wgl.c
@@ -1100,7 +1100,7 @@ static void make_context_current( TEB *teb, const struct opengl_funcs *funcs, HD
     {
         enum opengl_extension extensions[GL_EXTENSION_COUNT];
         size_t extension_count = parse_extensions( (const char *)funcs->p_glGetString( GL_EXTENSIONS ), extensions);
-        for (i = 0; i < extension_count; i++) client->extensions[i] = TRUE;
+        for (i = 0; i < extension_count; i++) client->extensions[extensions[i]] = TRUE;
     }
 
     pthread_once( &once, init_enabled_extensions );

