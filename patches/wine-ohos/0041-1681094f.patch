-        WARN("WineHua virgl connect(%s) failed: %s\n", debugstr_a(socket_path), strerror(errno));
-        close(fd);
-        return;
+        free(submission);
+        if (slot_acquired) InterlockedDecrement(&gl->state->in_flight);
     }
+    return ret;
+}
 
