+#include <stdlib.h>
+#include <string.h>
+
+#include "../winehua_smoke_protocol.h"
+
+struct vertex
+{
+    float x, y, z;
+    float r, g, b, a;
+    float u, v;
+};
+
+struct cube_constants
+{
+    float transform[16];
+};
+
+#define WINEHUA_FEATURE_PROBE_SIZE 64
+#define WINEHUA_RGBA_EXPECTED 0xff332211u
+#define WINEHUA_RGBA_MARKER 0xdeadbeefu
+
