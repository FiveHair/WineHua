+            ? VK_SUCCESS : present_result == -EAGAIN ? VK_SUBOPTIMAL_KHR
+            : present_result == -ENOSYS ? VK_ERROR_EXTENSION_NOT_PRESENT
+            : VK_ERROR_DEVICE_LOST;
