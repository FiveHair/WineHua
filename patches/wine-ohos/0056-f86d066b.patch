+    static const UINT border_x[WINEHUA_D24_BORDER_CASES] = {8, 24, 40, 56};
+    static const UINT border_y[WINEHUA_D24_BORDER_CASES] = {32, 32, 32, 32};
+    static const UINT border_expected[WINEHUA_D24_BORDER_CASES] = {
