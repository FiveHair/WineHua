+        if (state->texture3d_oob_values[i] != 0)
+            ++state->texture3d_oob_index_mismatches;
+    state->texture3d_oob_load_functional = marker_ok &&
+        state->texture3d_oob_load_mismatches == 0;
+    state->texture3d_oob_index_functional = marker_ok &&
