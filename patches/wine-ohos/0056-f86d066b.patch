+        "                   input.pos.y >= 32.0 ? 0.75 : 0.25);"
+        "float result = inputDepth.SampleCmpLevelZero("
+        "    comparisonSampler, uv, 0.5);"
+        "return float4(result, result, result, 1.0); }";
