 dlls/ntdll/unix/file.c      | 56 ++++++++++------------------------
 dlls/ntdll/unix/ohos_file.c | 60 +++++++++++++++++++++++++++++++++++++
 dlls/ntdll/unix/ohos_file.h | 49 ++++++++++++++++++++++++++++++
 4 files changed, 125 insertions(+), 41 deletions(-)
 create mode 100644 dlls/ntdll/unix/ohos_file.c
 create mode 100644 dlls/ntdll/unix/ohos_file.h

