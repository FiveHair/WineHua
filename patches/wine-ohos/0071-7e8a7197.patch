index 000000000000..7726e26c3dc9
--- /dev/null
+++ b/dlls/ntdll/unix/ohos_file.c
@@ -0,0 +1,60 @@
+/*
+ * WineHua file path helpers (no-symlink drive mapping)
+ *
+ * Copyright 2025-2026 WineHua contributors
