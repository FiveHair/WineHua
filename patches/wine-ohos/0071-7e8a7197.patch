-            }
-            else if (dev[0] >= 'c' && dev[0] <= 'y')
-                asprintf( &new_name, "%s/drive_%c", config_dir, dev[0] );
+            char path_buf[PATH_MAX];
+            int len = ohos_drive_unix_path( dev[0], config_dir,
